<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>汉堡小摊模拟器</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        terminal: {
                            bg: '#ffffff',
                            text: '#000000',
                            border: '#000000',
                            input: '#f0f0f0',
                            button: '#333333',
                            buttonText: '#ffffff'
                        }
                    },
                    fontFamily: {
                        mono: ['Courier New', 'monospace']
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer utilities {
            .terminal-shadow {
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            }
            .fixed-game-container {
                width: 100%;
                height: 500px;
                box-sizing: border-box;
                overflow: hidden;
            }
            .game-content {
                height: calc(100% - 60px);
                overflow-y: auto;
            }
            .interaction-area {
                height: 60px;
                box-sizing: border-box;
            }
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col items-center justify-center p-4">
    <div class="max-w-2xl w-full">
        <h1 class="text-3xl font-bold text-center mb-6 font-mono">汉堡小摊模拟器</h1>

        <div class="fixed-game-container border-4 border-terminal-border bg-terminal-bg rounded-md p-4 terminal-shadow">
            <div id="gameOutput" class="game-content font-mono text-terminal-text whitespace-pre-wrap"></div>

            <div class="interaction-area">
                <div id="inputArea" class="hidden flex items-center gap-2 h-full">
                    <input type="text" id="userInput" class="flex-1 bg-terminal-input border border-terminal-border p-2 rounded focus:outline-none focus:ring-2 focus:ring-terminal-border" placeholder="输入内容...">
                    <button id="submitBtn" class="bg-terminal-button text-terminal-text p-2 rounded hover:bg-gray-600 transition-colors">
                        <i class="fa fa-check text-terminal-buttonText"></i>
                    </button>
                </div>

                <div id="choicesArea" class="hidden flex flex-wrap gap-2 justify-center items-center h-full">
                    <!-- 按钮将动态生成在这里 -->
                </div>
            </div>
        </div>

        <div class="text-center mt-4 text-sm text-gray-600">
            <p>一个基于终端风格的汉堡小摊模拟游戏</p>
        </div>
    </div>

    <script>
        // 游戏数据
        const gameData = {
            // 游戏配置
            dayMax: 5,
            flowMap: [100, 70, 50],
            funNum: 14,
            limit: 19, // 14 + 5
            lenNum: 11,
            limit2: 12, // 11 + 1
            cost: 10,
            price: 15,

            // 游戏状态
            money: 3500,
            dayTime: 1,
            flow: 0,
            meat: 0,
            fresh: 0,
            rate: 0,
            rate2: 0,
            map: 0,
            dayCheck: 1,
            unlocked: [],
            name: '',
            wallet: {},
            currentInputType: '',
            currentChoiceCallback: null,
            outputLines: [],
            shortDelay: 600,
            ultraShortDelay: 300
        };

        // DOM 元素
        const gameOutput = document.getElementById('gameOutput');
        const inputArea = document.getElementById('inputArea');
        const userInput = document.getElementById('userInput');
        const submitBtn = document.getElementById('submitBtn');
        const choicesArea = document.getElementById('choicesArea');

        // 初始化游戏
        function initGame() {
            loadGameData();

            submitBtn.addEventListener('click', handleInputSubmit);
            userInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') handleInputSubmit();
            });

            startGame();
        }

        // 加载游戏数据
        function loadGameData() {
            const savedData = localStorage.getItem('burgerStandData');
            if (savedData) {
                gameData.wallet = JSON.parse(savedData);
            }
        }

        // 保存游戏数据
        function saveGameData() {
            gameData.wallet[gameData.name] = Math.round(gameData.money);
            localStorage.setItem('burgerStandData', JSON.stringify(gameData.wallet));
        }

        // 开始游戏
        function startGame() {
            addOutputLine("欢迎来到==汉堡小摊==模拟系统！");
            setTimeout(() => {
                showInput("请输入你的名字：", handleNameInput);
            }, gameData.shortDelay);
        }

        // 处理名字输入
        function handleNameInput(name) {
            gameData.name = name;

            if (gameData.wallet.hasOwnProperty(name)) {
                gameData.money = gameData.wallet[name];
                addOutputLine(`欢迎${name}回到汉堡小摊！`);
                setTimeout(() => {
                    addOutputLine(`${name}的当前余额：${gameData.money} 元`);

                    // 如果余额少于2000，夜市老板香小蕉补满到2000
                    if (gameData.money < 2000) {
                        setTimeout(() => {
                            addOutputLine(`你的余额不足2000元，夜市老板香小蕉帮你补满到2000元！`);
                            gameData.money = 2000;
                            setTimeout(startNewGame, gameData.shortDelay);
                        }, gameData.shortDelay);
                    } else {
                        setTimeout(startNewGame, gameData.shortDelay);
                    }
                }, gameData.shortDelay);
            } else {
                gameData.money = 3500;
                gameData.wallet[name] = 3500;
                addOutputLine(`欢迎${name}来到汉堡小摊，初始资金3500元！`);
                setTimeout(startNewGame, gameData.shortDelay);
            }
        }

        // 开始新游戏
        function startNewGame() {
            addOutputLine(`接下来${gameData.dayMax}天你将经营夜市上的一辆汉堡小餐车`);
            setTimeout(() => {
                addOutputLine(`首先请问你想要租夜市的哪个场地？你现在有${gameData.money}元`);
                setTimeout(() => {
                    showChoices("", ["1:高客流量(2000)", "2:中等客流量(1500)", "3:低客流量(1000)"], handleMapChoice);
                }, gameData.shortDelay);
            }, gameData.shortDelay);
        }

        // 处理场地选择
        function handleMapChoice(choice) {
            const map = parseInt(choice.charAt(0)) - 1;
            const costs = [2000, 1500, 1000];
            const cost = costs[map];

            if (gameData.money < cost) {
                addOutputLine("你的钱不够哦，请重新选择");
                setTimeout(() => {
                    showChoices("", ["1:高客流量(2000)", "2:中等客流量(1500)", "3:低客流量(1000)"], handleMapChoice);
                }, gameData.ultraShortDelay);
                return;
            }

            gameData.map = map;
            gameData.money -= cost;
            gameData.flow = gameData.flowMap[map];

            if (map === 0) {
                addOutputLine("你选择了高流量区，第一天流量约100单");
            } else if (map === 1) {
                addOutputLine("你选择了中等流量区，第一天流量约70单");
            } else {
                addOutputLine("你选择了低流量区，第一天流量约50单");
            }

            setTimeout(() => {
                addOutputLine("下面开始购买食材（一份食材对应一个汉堡）");
                setTimeout(() => {
                    addOutputLine("【提示】");
                    setTimeout(() => {
                        addOutputLine("购买食材需恰到好处~买少了赚钱少，买多了卖不完第二天新鲜度会降低");
                        setTimeout(() => {
                            addOutputLine("新购入食材后，新鲜度为原先食材和新食材混合的结果");
                            setTimeout(() => {
                                addOutputLine("新鲜度过低可能会导致顾客拉肚子（10为最新鲜，低于5为不新鲜），要注重食品安全问题哦");
                                setTimeout(() => {
                                    addOutputLine("当然你也可以选择丢弃仓库里不新鲜的食材");
                                    setTimeout(() => {
                                        addOutputLine("【提示】第二弹");
                                        setTimeout(() => {
                                            addOutputLine("过程中有可能触发问答环节，每个问题有两次回答机会");
                                            setTimeout(() => {
                                                addOutputLine("请尽可能言简意赅地答对关键词，按点给分哦");
                                                setTimeout(startDailyCycle, gameData.shortDelay);
                                            }, gameData.ultraShortDelay);
                                        }, gameData.ultraShortDelay);
                                    }, gameData.ultraShortDelay);
                                }, gameData.ultraShortDelay);
                            }, gameData.ultraShortDelay);
                        }, gameData.ultraShortDelay);
                    }, gameData.ultraShortDelay);
                }, gameData.ultraShortDelay);
            }, gameData.shortDelay);
        }

        // 开始每日循环
        function startDailyCycle() {
            if (gameData.dayTime > gameData.dayMax) {
                setTimeout(endGame, gameData.shortDelay);
                return;
            }

            addOutputLine(`\n今天是第${gameData.dayTime}天`);
            setTimeout(purchase, gameData.shortDelay);
        }

        // 购买食材
        function purchase() {
            addOutputLine(`你现在的余额为${Math.round(gameData.money)}元`);

            setTimeout(() => {
                if (gameData.dayTime !== 1 && gameData.meat > 0) {
                    addOutputLine(`你现在还有${Math.round(gameData.meat)}份食材，新鲜度为${Math.min(10, Math.round(gameData.fresh * 100) / 100)}`);
                    setTimeout(() => {
                        showInput("请输入你要丢弃食材的数量，不丢弃请输入0", handleDiscard);
                    }, gameData.ultraShortDelay);
                } else if (gameData.dayTime !== 1 && gameData.meat === 0) {
                    addOutputLine("你现在手上没有食材了");
                    setTimeout(() => {
                        proceedPurchase();
                    }, gameData.ultraShortDelay);
                } else {
                    setTimeout(() => {
                        proceedPurchase();
                    }, gameData.ultraShortDelay);
                }
            }, gameData.ultraShortDelay);
        }

        // 处理丢弃食材
        function handleDiscard(input) {
            const discard = parseInt(input);
            if (isNaN(discard) || discard < 0 || discard > gameData.meat) {
                addOutputLine("请输入合理的数字");
                setTimeout(() => {
                    showInput("请输入你要丢弃食材的数量，不丢弃请输入0", handleDiscard);
                }, gameData.ultraShortDelay);
                return;
            }

            gameData.meat -= discard;
            if (discard > 0) {
                addOutputLine(`丢弃${discard}份食材，剩余${gameData.meat}份`);
            }

            setTimeout(proceedPurchase, gameData.shortDelay);
        }

        // 继续购买流程
        function proceedPurchase() {
            const maxBuy = Math.floor(gameData.money / gameData.cost);
            addOutputLine(`一份汉堡食材的成本为${gameData.cost}元,售价${gameData.price}元，你最多可以购入${maxBuy}份食材`);
            setTimeout(() => {
                showInput("请问你要购买几份食材？", handleBuyCount);
            }, gameData.ultraShortDelay);
        }

        // 处理购买数量
        function handleBuyCount(input) {
            const count = parseInt(input);
            if (isNaN(count) || count < 0) {
                addOutputLine("请输入合理的数字");
                setTimeout(() => {
                    showInput("请问你要购买几份食材？", handleBuyCount);
                }, gameData.ultraShortDelay);
                return;
            }

            if (count * gameData.cost > gameData.money) {
                addOutputLine("你的钱钱不够哦，请重新输入");
                setTimeout(() => {
                    showInput("请问你要购买几份食材？", handleBuyCount);
                }, gameData.ultraShortDelay);
                return;
            }

            // 更新新鲜度
            if (gameData.meat + count > 0) {
                gameData.fresh = (gameData.meat * gameData.fresh + count * 10) / (gameData.meat + count);
            } else {
                gameData.fresh = 0;
            }

            gameData.meat += count;
            gameData.money -= count * gameData.cost;

            addOutputLine(`购买成功！当前余额：${Math.round(gameData.money)}元，当前食材：${gameData.meat}份，新鲜度：${Math.min(Math.round(gameData.fresh * 100) / 100, 10)}`);
            setTimeout(daily, gameData.shortDelay);
        }

        // 每日经营
        function daily() {
            gameData.rate = gameData.rate2;
            gameData.rate2 = 0;

            // 随机事件
            setTimeout(() => {
                const r = Math.floor(Math.random() * (gameData.limit + 1));
                if (r <= gameData.funNum) {
                    window[`fun${r}`]();
                } else {
                    setTimeout(continueDaily, gameData.shortDelay);
                }
            }, gameData.ultraShortDelay);
        }

        // 继续每日流程
        function continueDaily() {
            // 第二次随机事件
            const r1 = Math.floor(Math.random() * (gameData.limit + 1));
            const r2 = Math.floor(Math.random() * 2) + 1;

            if (r1 <= gameData.funNum && r2 === 1) {
                setTimeout(() => {
                    window[`fun${r1}`]();
                }, gameData.shortDelay);
            } else {
                setTimeout(checkDurianEvent, gameData.shortDelay);
            }
        }

        // 检查榴莲事件
        function checkDurianEvent() {
            if (gameData.unlocked.includes('durian')) {
                const r = Math.floor(Math.random() * 3) + 1;
                if (r === 1) {
                    setTimeout(fun_durain, gameData.shortDelay);
                    return;
                }
            }

            setTimeout(processSales, gameData.shortDelay);
        }

        // 处理销售
        function processSales() {
            if (gameData.dayCheck > 5) {
                setTimeout(endDay, gameData.shortDelay);
                return;
            }

            let flow = gameData.flowMap[gameData.map];
            flow = flow * (1 + gameData.rate);
            const r = Math.floor(Math.random() * (Math.floor(flow * 0.15) * 2 + 1)) - Math.floor(flow * 0.15);
            flow += r;
            flow = Math.max(0, flow);

            setTimeout(() => {
                const sold = Math.min(gameData.meat, Math.floor(flow));

                gameData.money += sold * gameData.price;

                if (flow > gameData.meat) {
                    addOutputLine("准备的汉堡都卖完啦，下次记得准备足够数量的汉堡哦");
                } else if (flow === gameData.meat) {
                    addOutputLine("你简直是个天才，准备的食材不多不少刚刚好");
                } else {
                    if (gameData.dayTime <= gameData.dayMax - 1) {
                        addOutputLine("食材买多了，没事，明天再战！");
                    } else {
                        addOutputLine("食材买多了，今天也是你经营的最后一天了，隔壁摊主向你以1元一份的价格回收食材");

                        if (gameData.fresh <= 6.5) {
                            setTimeout(() => {
                                addOutputLine("隔壁摊主一看食材，呀~不太新鲜~，说蒜鸟蒜鸟");
                                setTimeout(() => {
                                    addOutputLine("隔壁摊主选择了不回收");
                                }, gameData.ultraShortDelay);
                            }, gameData.ultraShortDelay);
                        } else {
                            const leftover = gameData.meat - sold;
                            gameData.money += leftover;
                            addOutputLine(`卖出${leftover}份食材，回收${leftover}元`);
                        }
                    }
                }

                gameData.meat -= sold;

                setTimeout(() => {
                    if (gameData.unlocked.includes('accountant') && !gameData.unlocked.includes('accountant_advanced')) {
                        addOutputLine(`今天一共出售了${sold}个汉堡，理应收益${sold * gameData.price}元，理应总余额${Math.round(gameData.money)}元`);
                        const r = Math.floor(Math.random() * 24) - 15; // -15 到 8
                        gameData.money = Math.round(gameData.money * (1 + r / 100) * 10) / 10;
                        addOutputLine(`菠小萝结算余额为${gameData.money}元`);

                        if (r < 0) {
                            setTimeout(() => {
                                showChoices("是否需要送菠小萝去上“会计进阶班”?  ", ["1:去（花费300元）", "2：不去"], handleAccountantTraining);
                            }, gameData.ultraShortDelay);
                        } else {
                            setTimeout(updateFreshness, gameData.ultraShortDelay);
                        }
                    } else if (gameData.unlocked.includes('accountant_advanced')) {
                        addOutputLine(`今天一共出售了${sold}个汉堡，理应收益${sold * gameData.price}元，理应总余额${Math.round(gameData.money)}元`);
                        const r = Math.floor(Math.random() * 14) - 3; // -3 到 10
                        gameData.money = Math.round(gameData.money * (1 + r / 100) * 10) / 10;
                        addOutputLine(`菠小萝结算余额为${gameData.money}元`);
                        setTimeout(updateFreshness, gameData.ultraShortDelay);
                    } else {
                        addOutputLine(`今天一共出售了${sold}个汉堡，收益${sold * gameData.price}元，总余额${Math.round(gameData.money)}元`);
                        setTimeout(updateFreshness, gameData.ultraShortDelay);
                    }
                }, gameData.ultraShortDelay);
            }, gameData.ultraShortDelay);
        }

        // 处理会计培训选择
        function handleAccountantTraining(choice) {
            if (choice === "1:去（花费300元）") {
                if (gameData.money < 300) {
                    addOutputLine("你的钱钱不够哦~ 菠小萝没有去上会计进阶班");
                    setTimeout(updateFreshness, gameData.ultraShortDelay);
                } else {
                    addOutputLine("菠小萝去上会计进阶班了");
                    gameData.unlocked.push('accountant_advanced');
                    gameData.money -= 300;
                    setTimeout(updateFreshness, gameData.ultraShortDelay);
                }
            } else {
                addOutputLine("菠小萝没有去上会计进阶班");
                setTimeout(updateFreshness, gameData.ultraShortDelay);
            }
        }

        // 更新新鲜度
        function updateFreshness() {
            setTimeout(() => {
                if (gameData.fresh >= 7.5) {
                    addOutputLine("你用的食材很新鲜，得到了顾客的好评");
                    gameData.rate2 += 0.1;
                }
                if (gameData.fresh < 5) {
                    addOutputLine("你的食材不新鲜了，有的顾客吃了拉肚子，在网上发避雷帖子");
                    gameData.rate -= 0.2;
                }

                gameData.fresh = Math.max(Math.round((gameData.fresh - 5) * 100) / 100, 0);
                setTimeout(endDay, gameData.ultraShortDelay);
            }, gameData.ultraShortDelay);
        }

        // 结束当天
        function endDay() {
            gameData.dayTime++;
            setTimeout(startDailyCycle, gameData.shortDelay);
        }

        // 结束游戏
        function endGame() {
            addOutputLine("\n======余额结算======");
            addOutputLine(`你的最终余额为${Math.round(gameData.money)}元`);
            saveGameData();
            setTimeout(() => {
                showChoices("是否开始新一轮游戏？", ["是", "否"], handleNewGameChoice);
            }, gameData.shortDelay);
        }

        // 处理新一轮游戏选择
        function handleNewGameChoice(choice) {
            if (choice === "是") {
                // 重置游戏状态
                gameData.dayTime = 1;
                gameData.flow = 0;
                gameData.meat = 0;
                gameData.fresh = 0;
                gameData.rate = 0;
                gameData.rate2 = 0;
                gameData.dayCheck = 1;
                gameData.unlocked = [];
                gameData.cost = 10;
                gameData.price = 15;

                setTimeout(startNewGame, gameData.shortDelay);
            } else {
                addOutputLine("游戏结束，余额已保存！");
            }
        }

        // 问答函数
        function len0() {
            return new Promise((resolve) => {
                const keyword = ['宁愿选择榴莲不放手', '宁愿选择留恋不放手'];
                let attempts = 0;

                function checkAnswer(ans) {
                    if (keyword.some(k => ans.includes(k))) {
                        resolve(true);
                        return true;
                    }
                    attempts++;
                    if (attempts < 2) {
                        showInput('请问抱着榴莲但一不小心脱手的时候应该唱？', checkAnswer);
                    } else {
                        resolve(false);
                    }
                    return false;
                }

                showInput('请问抱着榴莲但一不小心脱手的时候应该唱？', checkAnswer);
            });
        }

        function len1() {
            return new Promise((resolve) => {
                const keyword = ['瑞士'];
                let attempts = 0;

                function checkAnswer(ans) {
                    if (keyword.some(k => ans.includes(k))) {
                        resolve(true);
                        return true;
                    }
                    attempts++;
                    if (attempts < 2) {
                        showInput('请问世界上最卷的地方是哪里', checkAnswer);
                    } else {
                        resolve(false);
                    }
                    return false;
                }

                showInput('请问世界上最卷的地方是哪里', checkAnswer);
            });
        }

        function len2() {
            return new Promise((resolve) => {
                const keyword = ['旺旺仙贝', '旺旺掀被'];
                let attempts = 0;

                function checkAnswer(ans) {
                    if (keyword.some(k => ans.includes(k))) {
                        resolve(true);
                        return true;
                    }
                    attempts++;
                    if (attempts < 2) {
                        showInput('旺旺雪饼到了夏天会变成_____?', checkAnswer);
                    } else {
                        resolve(false);
                    }
                    return false;
                }

                showInput('旺旺雪饼到了夏天会变成_____?', checkAnswer);
            });
        }

        function len3() {
            return new Promise((resolve) => {
                const keyword = ['真相会浮出水面', '真象会浮出水面', '推入水里', '推到水里', '推入水中', '推到水中'];
                let attempts = 0;

                function checkAnswer(ans) {
                    if (keyword.some(k => ans.includes(k))) {
                        resolve(true);
                        return true;
                    }
                    attempts++;
                    if (attempts < 2) {
                        showInput('请问如何区分真象和假象', checkAnswer);
                    } else {
                        resolve(false);
                    }
                    return false;
                }

                showInput('请问如何区分真象和假象', checkAnswer);
            });
        }

        function len4() {
            return new Promise((resolve) => {
                const keyword = ['酵母', '教母'];
                let attempts = 0;

                function checkAnswer(ans) {
                    if (keyword.some(k => ans.includes(k))) {
                        resolve(true);
                        return true;
                    }
                    attempts++;
                    if (attempts < 2) {
                        showInput('请问鸭梨是水果教的教主，榴莲是什么？', checkAnswer);
                    } else {
                        resolve(false);
                    }
                    return false;
                }

                showInput('请问鸭梨是水果教的教主，榴莲是什么？', checkAnswer);
            });
        }

        function len5() {
            return new Promise((resolve) => {
                const keyword = ['太挤'];
                let attempts = 0;

                function checkAnswer(ans) {
                    if (keyword.some(k => ans.includes(k))) {
                        resolve(true);
                        return true;
                    }
                    attempts++;
                    if (attempts < 2) {
                        showInput('太空有空间站，______没有空间站', checkAnswer);
