                addOutputLine('使用过期食材，使用地沟油，导致很多人吃了进医院');
                setTimeout(() => {
                    addOutputLine('请大家注重食品安全');
                    setTimeout(() => {
                        addOutputLine('结果：客流量永久减少30%');
                        gameData.flowMap[gameData.map] -= Math.floor(gameData.flowMap[gameData.map] * 0.3);
                        setTimeout(continueDaily, gameData.shortDelay);
                    }, gameData.ultraShortDelay);
                }, gameData.ultraShortDelay);
            }, gameData.ultraShortDelay);
        }

        function fun12() {
            addOutputLine('遇上了一帮子喝醉酒的小混混');
            setTimeout(() => {
                addOutputLine('他们发酒疯的时候撞倒了你的摊子');
                setTimeout(() => {
                    const r = Math.floor(Math.random() * (gameData.meat + 1));
                    addOutputLine(`损失一部分食材（${r}份食材）`);
                    gameData.meat -= r;
                    setTimeout(continueDaily, gameData.shortDelay);
                }, gameData.ultraShortDelay);
            }, gameData.ultraShortDelay);
        }

        function fun13() {
            addOutputLine('你的摊子隔壁也来了一个卖汉堡的，来和你抢生意');
            setTimeout(() => {
                addOutputLine('ta走薄利多销路线，你现在面临两个选择');
                setTimeout(() => {
                    showChoices("", ["1：降价出售（单价-2）", "2：原价出售（客流量永久-20%）"], (choice) => {
                        if (choice === "1：降价出售（单价-2）") {
                            addOutputLine('你选择了降价出售');
                            gameData.price -= 2;
                            setTimeout(continueDaily, gameData.shortDelay);
                        } else {
                            addOutputLine('你选择了硬刚！（客流量减少）');
                            const flowChange = Math.floor(gameData.flowMap[gameData.map] * 0.2);
                            gameData.flowMap[gameData.map] -= flowChange;

                            const r = Math.floor(Math.random() * gameData.limit2) + 1;
                            if (r <= gameData.lenNum) {
                                addOutputLine('触发问答环节，回答正确即可免受惩罚');
                                setTimeout(async () => {
                                    const result = await window[`len${r}`]();
                                    if (result) {
                                        addOutputLine('回答正确，客流量不变');
                                        gameData.flowMap[gameData.map] += flowChange;
                                    } else {
                                        addOutputLine('oh no，回答错误，客流量减少。。');
                                    }
                                    setTimeout(continueDaily, gameData.shortDelay);
                                }, gameData.shortDelay);
                            } else {
                                setTimeout(continueDaily, gameData.shortDelay);
                            }
                        }
                    });
                }, gameData.ultraShortDelay);
            }, gameData.ultraShortDelay);
        }

        function fun14() {
            if (gameData.unlocked.includes('accountant')) {
                setTimeout(continueDaily, gameData.shortDelay);
                return;
            }

            addOutputLine('神秘顾客【菠小萝】来到了你的摊子，说自己有会计证，可以帮你算账');
            setTimeout(() => {
                const daysLeft = gameData.dayMax - gameData.dayTime + 1;
                const cost = 50 * daysLeft;
                addOutputLine(`需要聘请菠小萝来帮忙收银吗？（50元/天）这样你有更多的时间招揽顾客，共需${cost}元`);
                setTimeout(() => {
                    showChoices("", ["1：聘请(至游戏结束)", "2：不聘请"], (choice) => {
                        if (choice === "1：聘请(至游戏结束)") {
                            if (gameData.money < cost) {
                                addOutputLine('你的钱钱不够哦~ 菠小萝走了');
                                setTimeout(continueDaily, gameData.shortDelay);
                            } else {
                                addOutputLine(`你聘请了菠小萝来收银， 花费${cost}元`);
                                gameData.money -= cost;
                                gameData.unlocked.push('accountant');
                                gameData.flowMap[gameData.map] += 10;
                                setTimeout(continueDaily, gameData.shortDelay);
                            }
                        } else {
                            addOutputLine('菠小萝走了');
                            setTimeout(continueDaily, gameData.shortDelay);
                        }
                    });
                }, gameData.ultraShortDelay);
            }, gameData.ultraShortDelay);
        }

        // 添加输出行
        function addOutputLine(text) {
            gameData.outputLines.push(text);
            updateOutputDisplay();
            gameOutput.scrollTop = gameOutput.scrollHeight;
        }

        // 更新输出显示
        function updateOutputDisplay() {
            gameOutput.textContent = gameData.outputLines.join('\n');
        }

        // 显示输入框
        function showInput(promptText, callback) {
            choicesArea.classList.add('hidden');
            addOutputLine(promptText);
            inputArea.classList.remove('hidden');
            userInput.value = '';
            userInput.focus();
            gameData.currentInputType = 'text';
            gameData.currentChoiceCallback = callback;
        }

        // 显示选择按钮
        function showChoices(promptText, choices, callback) {
            inputArea.classList.add('hidden');
            if (promptText) {
                addOutputLine(promptText);
            }
            choicesArea.classList.remove('hidden');
            choicesArea.innerHTML = '';

            choices.forEach(choice => {
                const button = document.createElement('button');
                button.className = 'bg-terminal-button text-terminal-buttonText px-4 py-2 rounded hover:bg-gray-600 transition-colors';
                button.textContent = choice;
                button.addEventListener('click', () => {
                    choicesArea.classList.add('hidden');
                    callback(choice);
                });
                choicesArea.appendChild(button);
            });

            gameData.currentInputType = 'choice';
            gameData.currentChoiceCallback = callback;
        }

        // 处理输入提交
        function handleInputSubmit() {
            const input = userInput.value.trim();
            if (input) {
                inputArea.classList.add('hidden');
                if (gameData.currentChoiceCallback) {
                    gameData.currentChoiceCallback(input);
                }
            }
        }

        // 初始化游戏
        window.onload = initGame;
    </script>
</body>
</html>
